    <!-- Client Logic & Soundbox Script -->
    <script>
        <% if (payment) { %>
        const paymentId = '<%= payment.payment_id %>';
        const orderId = '<%= payment.order_id || payment.payment_id %>';
        const totalAmount = <%= payment.amount %>;
        // Numeric timestamp eliminates any browser date-string parsing discrepancy (NaN)
        const expiresAt = <%= payment.expires_timestamp || (payment.expires_at ? new Date(payment.expires_at).getTime() : 0) %>;
        const createdAt = <%= payment.created_timestamp || (payment.created_at ? new Date(payment.created_at).getTime() : Date.now()) %>;
        const redirectUrl = <%= payment.redirect_url ? JSON.stringify(payment.redirect_url) : 'null' %>;
        <% } else { %>
        const paymentId = null;
        const orderId = null;
        const totalAmount = 0;
        const expiresAt = 0;
        const createdAt = 0;
        const redirectUrl = null;
        <% } %>

        let isPaid = <%= payment && payment.status === 'PAID' ? 'true' : 'false' %>;
        let isExpired = false;
        let pollTimer = null;
        let countdownTimer = null;
        let finalRedirectUrl = redirectUrl;

        // Dark Mode Controller
        function initTheme() {
            const savedTheme = localStorage.getItem('yuripay_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
                const icon = document.getElementById('theme-icon');
                if (icon) icon.className = 'fa-solid fa-sun text-amber-400';
            } else {
                document.documentElement.classList.remove('dark');
                const icon = document.getElementById('theme-icon');
                if (icon) icon.className = 'fa-solid fa-moon text-slate-700';
            }
        }

        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('yuripay_theme', isDark ? 'dark' : 'light');
            const icon = document.getElementById('theme-icon');
            if (icon) {
                icon.className = isDark ? 'fa-solid fa-sun text-amber-400' : 'fa-solid fa-moon text-slate-700';
            }
        }
        initTheme();

        // Audio files
        const arigatoLocal = new Audio('/sounds/cute-arigato.mp3');
        const arigatoOnline = new Audio('https://www.myinstants.com/media/sounds/cute-arigato.mp3');

        // Success Theme Mode: 'anime' (Marin Kitagawa pop-up) vs 'default' (Corporate fintech chime)
        const serverSuccessTheme = '<%= payment ? payment.success_theme : "anime" %>';
        const savedThemePref = localStorage.getItem('yuripay_user_success_theme');
        let currentSuccessTheme = savedThemePref || serverSuccessTheme || 'anime';

        function initSuccessThemeUI() {
            const badge = document.getElementById('badge-theme-mode');
            const label = document.getElementById('label-theme-mode');
            if (badge && label) {
                if (currentSuccessTheme === 'anime') {
                    badge.className = 'w-2 h-2 rounded-full bg-pink-500 animate-pulse';
                    label.innerText = 'Mode Anime';
                } else {
                    badge.className = 'w-2 h-2 rounded-full bg-emerald-500';
                    label.innerText = 'Mode Default';
                }
            }
        }

        function toggleSuccessThemeMode() {
            currentSuccessTheme = currentSuccessTheme === 'anime' ? 'default' : 'anime';
            localStorage.setItem('yuripay_user_success_theme', currentSuccessTheme);
            initSuccessThemeUI();
        }
        initSuccessThemeUI();

        // Soundbox Mute Setting
        let isMuted = localStorage.getItem('yuripay_sound_muted') === 'true';
        function initSoundSetting() {
            const icon = document.getElementById('sound-icon');
            if (icon) {
                icon.className = isMuted ? 'fa-solid fa-volume-xmark text-slate-400' : 'fa-solid fa-volume-high text-brandBlue dark:text-sky-400';
            }
        }
        function toggleSound() {
            isMuted = !isMuted;
            localStorage.setItem('yuripay_sound_muted', isMuted ? 'true' : 'false');
            initSoundSetting();
        }
        initSoundSetting();

        // Collapsible instructions
        function toggleInstructions() {
            const content = document.getElementById('instruction-content');
            const arrow = document.getElementById('instruction-arrow');
            if (!content || !arrow) return;
            const isHidden = content.classList.toggle('hidden');
            arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
        }

        // 1. Play Cute Arigato Sound (Anime Mode)
        function playCuteSound() {
            if (isMuted) return;
            arigatoLocal.currentTime = 0;
            arigatoLocal.play().catch(() => {
                arigatoOnline.currentTime = 0;
                arigatoOnline.play().catch(e => console.warn('Audio play:', e));
            });
        }

        // 2. Play Corporate Fintech Chime (Default Mode via Web Audio API)
        function playDefaultChime() {
            if (isMuted) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;

                // Two-tone bell chord (523.25Hz [C5] -> 783.99Hz [G5])
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(523.25, now);
                osc1.frequency.exponentialRampToValueAtTime(783.99, now + 0.14);
                gain1.gain.setValueAtTime(0.35, now);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 1.1);
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(now);
                osc1.stop(now + 1.1);

                // Harmonious shimmer overtone
                const osc2 = ctx.createOscillator();
                const gain2 = ctx.createGain();
                osc2.type = 'triangle';
                osc2.frequency.setValueAtTime(1046.5, now + 0.08);
                gain2.gain.setValueAtTime(0.15, now + 0.08);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.9);
                osc2.connect(gain2);
                gain2.connect(ctx.destination);
                osc2.start(now + 0.08);
                osc2.stop(now + 0.9);
            } catch (e) {
                console.warn('Default audio chime error:', e);
            }
        }

        // Confetti fireworks
        function launchConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 80,
                    origin: { y: 0.6 }
                });
                setTimeout(() => {
                    confetti({
                        particleCount: 60,
                        angle: 60,
                        spread: 60,
                        origin: { x: 0.1, y: 0.7 }
                    });
                    confetti({
                        particleCount: 60,
                        angle: 120,
                        spread: 60,
                        origin: { x: 0.9, y: 0.7 }
                    });
                }, 300);
            }
        }

        // Build Midtrans-compatible OP redirect URL
        function buildOpRedirectUrl(targetUrl, paymentId, ordId, amount, tx) {
            try {
                const urlObj = new URL(targetUrl);
                urlObj.searchParams.set('order_id', ordId || paymentId);
                urlObj.searchParams.set('status_code', '200');
                urlObj.searchParams.set('transaction_status', 'settlement');
                urlObj.searchParams.set('payment_type', 'qris');
                urlObj.searchParams.set('gross_amount', Number(amount).toFixed(2));
                urlObj.searchParams.set('payment_id', paymentId);
                if (tx?.transaction_id) {
                    urlObj.searchParams.set('transaction_id', tx.transaction_id);
                }
                return urlObj.toString();
            } catch (e) {
                const sep = targetUrl.includes('?') ? '&' : '?';
                return `${targetUrl}${sep}order_id=${encodeURIComponent(ordId || paymentId)}&status_code=200&transaction_status=settlement&gross_amount=${Number(amount).toFixed(2)}&payment_id=${paymentId}`;
            }
        }

        function showAnimeModal() {
            document.getElementById('anime-modal').classList.remove('hidden');
        }

        function closeAnimeModal() {
            document.getElementById('anime-modal').classList.add('hidden');
            if (finalRedirectUrl) {
                window.location.href = finalRedirectUrl;
            }
        }

        // Copy Amount with visual and haptic feedback
        function copyAmount(val) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(val).then(showCopiedState);
            } else {
                const ta = document.createElement('textarea');
                ta.value = val;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showCopiedState();
            }

            // Haptic vibration feedback on mobile
            if (navigator.vibrate) {
                navigator.vibrate(50);
            }
        }

        function showCopiedState() {
            const label = document.getElementById('copy-text');
            const icon = document.getElementById('copy-icon');
            const origText = label.innerText;
            
            label.innerText = 'Nominal Tersalin!';
            icon.className = 'fa-solid fa-check text-emerald-500';
            
            setTimeout(() => {
                label.innerText = origText;
                icon.className = 'fa-regular fa-copy text-brandBlue dark:text-sky-400';
            }, 2000);
        }

        // Generic copy helper
        function copyText(val, iconId) {
            if (!val) return;
            navigator.clipboard.writeText(val).then(() => {
                const icon = document.getElementById(iconId);
                if (icon) {
                    const origClass = icon.className;
                    icon.className = 'fa-solid fa-check text-emerald-500';
                    setTimeout(() => { icon.className = origClass; }, 2000);
                }
            });
            if (navigator.vibrate) navigator.vibrate(40);
        }

        // ====================================================
        // ROCK-SOLID COUNTDOWN TIMER WITH PROGRESS BAR
        // ====================================================
        function updateCountdown() {
            if (isPaid || !expiresAt) return;
            
            const timerEl = document.getElementById('countdown-timer');
            const badgeEl = document.getElementById('countdown-badge');
            const progressEl = document.getElementById('countdown-progress-bar');
            const statusLabel = document.getElementById('status-label');
            const checkBtn = document.getElementById('btn-check-manual');
            const checkBtnText = document.getElementById('check-btn-text');
            const expiredOverlay = document.getElementById('qr-expired-overlay');
            const scanLine = document.getElementById('scan-line');
            const pingDot = document.getElementById('ping-dot');

            const now = Date.now();
            const diff = Math.max(0, expiresAt - now);
            const totalDuration = Math.max(1000, expiresAt - createdAt);
            const percent = Math.max(0, Math.min(100, (diff / totalDuration) * 100));

            const minutes = Math.floor(diff / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);
            const timeString = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

            if (timerEl) {
                timerEl.innerText = timeString;
            }

            if (progressEl) {
                progressEl.style.width = percent + '%';
            }

            // Dynamic color progression based on remaining time
            if (diff > 300000) {
                // > 5 minutes: Healthy Emerald
                if (badgeEl) {
                    badgeEl.className = 'font-mono font-extrabold px-2.5 py-0.5 rounded-full text-xs bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-300/50 dark:border-emerald-800 transition-colors';
                }
                if (progressEl) {
                    progressEl.className = 'h-2 rounded-full bg-gradient-to-r from-sky-500 to-emerald-500 transition-all duration-500 ease-linear';
                }
            } else if (diff > 120000) {
                // 2 - 5 minutes: Warning Amber
                if (badgeEl) {
                    badgeEl.className = 'font-mono font-extrabold px-2.5 py-0.5 rounded-full text-xs bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-400 border border-amber-300/50 dark:border-amber-800 transition-colors';
                }
                if (progressEl) {
                    progressEl.className = 'h-2 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-500 ease-linear';
                }
            } else if (diff > 0) {
                // < 2 minutes: Urgent Red (Pulsing)
                if (badgeEl) {
                    badgeEl.className = 'font-mono font-extrabold px-2.5 py-0.5 rounded-full text-xs bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-300/50 dark:border-rose-800 animate-pulse transition-colors';
                }
                if (progressEl) {
                    progressEl.className = 'h-2 rounded-full bg-rose-500 animate-pulse transition-all duration-500 ease-linear';
                }
            } else {
                // EXPIRED
                isExpired = true;
                if (countdownTimer) clearInterval(countdownTimer);
                if (pollTimer) clearInterval(pollTimer);

                if (timerEl) timerEl.innerText = '00:00 (Kedaluwarsa)';
                if (badgeEl) {
                    badgeEl.className = 'font-mono font-extrabold px-2.5 py-0.5 rounded-full text-xs bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-300 dark:border-slate-700';
                }
                if (progressEl) {
                    progressEl.style.width = '0%';
                    progressEl.className = 'h-2 rounded-full bg-slate-400';
                }

                if (statusLabel) {
                    statusLabel.innerText = 'Batas waktu pembayaran habis. Tagihan telah kedaluwarsa.';
                }
                if (pingDot) {
                    pingDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 inline-block';
                }
                if (scanLine) {
                    scanLine.classList.add('hidden');
                }
                if (expiredOverlay) {
                    expiredOverlay.classList.remove('hidden');
                }
                if (checkBtn) {
                    checkBtn.disabled = true;
                    checkBtn.classList.remove('bg-brandBlue', 'hover:bg-brandBlueHover', 'dark:bg-sky-600', 'dark:hover:bg-sky-500', 'shadow-blue-500/25');
                    checkBtn.classList.add('bg-slate-300', 'dark:bg-slate-800', 'text-slate-500', 'cursor-not-allowed', 'shadow-none');
                }
                if (checkBtnText) {
                    checkBtnText.innerText = 'Tagihan Telah Kedaluwarsa';
                }
            }
        }

        function startCountdown() {
            if (!paymentId || isPaid || !expiresAt) return;
            // Immediate tick to paint accurate time without 1s lag!
            updateCountdown();
            countdownTimer = setInterval(updateCountdown, 1000);
        }

        // ====================================================
        // REALTIME MUTATION POLLING
        // ====================================================
        function startPolling() {
            if (!paymentId || isPaid || isExpired) return;
            pollTimer = setInterval(async () => {
                if (isPaid || isExpired) {
                    clearInterval(pollTimer);
                    return;
                }
                await checkStatus(false);
            }, 2500);
        }

        async function checkStatus(isManual = false) {
            if (!paymentId || isPaid || isExpired) return;

            const icon = document.getElementById('check-icon');
            const btn = document.getElementById('btn-check-manual');
            const statusLabel = document.getElementById('status-label');

            if (isManual) {
                if (icon) icon.classList.add('animate-spin');
                if (btn) btn.disabled = true;
                if (statusLabel) statusLabel.innerText = 'Menghubungkan ke mutasi server...';
            }

            try {
                const res = await fetch(`/api/payment-status/${paymentId}`);
                const data = await res.json();

                if (data.success && data.paid) {
                    handleSuccess(data);
                } else if (data.status === 'EXPIRED') {
                    isExpired = true;
                    updateCountdown();
                } else if (isManual) {
                    if (statusLabel) {
                        statusLabel.innerText = data.message || 'Pembayaran belum terdeteksi. Silakan selesaikan transfer lalu coba lagi.';
                    }
                }
            } catch (err) {
                console.warn('Status poll warning:', err);
            } finally {
                if (isManual) {
                    if (icon) icon.classList.remove('animate-spin');
                    if (btn && !isExpired) btn.disabled = false;
                }
            }
        }

        function checkStatusManual() {
            checkStatus(true);
        }

        // ====================================================
        // PAYMENT CONFIRMATION & CELEBRATION
        // ====================================================
        function handleSuccess(data) {
            isPaid = true;
            if (pollTimer) clearInterval(pollTimer);
            if (countdownTimer) clearInterval(countdownTimer);

            // 1. Confetti burst
            launchConfetti();

            // 2. Play sound & celebration based on Success Theme
            if (currentSuccessTheme === 'anime') {
                playCuteSound();
                showAnimeModal();
            } else {
                playDefaultChime();
            }

            // 3. Switch UI View to Success Stage
            const waitingEl = document.getElementById('stage-waiting');
            const successEl = document.getElementById('stage-success');
            if (waitingEl) waitingEl.classList.add('hidden');
            if (successEl) successEl.classList.remove('hidden');

            const timeValEl = document.getElementById('receipt-time-val');
            if (timeValEl) {
                timeValEl.innerText = new Date().toLocaleString('id-ID');
            }

            // 4. OP Redirect Handling
            if (redirectUrl) {
                finalRedirectUrl = buildOpRedirectUrl(redirectUrl, paymentId, orderId, totalAmount, data?.transaction);
                const btnRedirect = document.getElementById('btn-redirect-now');
                if (btnRedirect) btnRedirect.href = finalRedirectUrl;

                let secLeft = 5;
                const rEl = document.getElementById('redirect-countdown');
                const pEl = document.getElementById('redirect-progress');
                
                const rInterval = setInterval(() => {
                    secLeft--;
                    if (rEl) rEl.innerText = secLeft;
                    if (pEl) pEl.style.width = (secLeft / 5 * 100) + '%';
                    
                    if (secLeft <= 0) {
                        clearInterval(rInterval);
                        window.location.href = finalRedirectUrl;
                    }
                }, 1000);
            }
        }

        // Initialize on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            if (paymentId && !isPaid) {
                startCountdown();
                startPolling();
            } else if (paymentId && isPaid) {
                const waitingEl = document.getElementById('stage-waiting');
                const successEl = document.getElementById('stage-success');
                if (waitingEl) waitingEl.classList.add('hidden');
                if (successEl) successEl.classList.remove('hidden');

                if (redirectUrl) {
                    finalRedirectUrl = buildOpRedirectUrl(redirectUrl, paymentId, orderId, totalAmount);
                    const btnRedirect = document.getElementById('btn-redirect-now');
                    if (btnRedirect) btnRedirect.href = finalRedirectUrl;
                }
            }
        });
    </script>
</body>
</html>
