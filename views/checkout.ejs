                            <span class="text-slate-400">Nomor Pesanan:</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200"><%= payment.order_id || payment.payment_id %></span>
                        </div>
                        <div class="flex justify-between items-center border-b border-slate-200/60 dark:border-slate-700/60 pb-2">
                            <span class="text-slate-400">Pesanan:</span>
                            <span class="font-medium text-slate-800 dark:text-slate-200 truncate max-w-[190px]"><%= payment.custom_name %></span>
