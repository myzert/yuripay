    <!-- ============================================== -->
    <!-- CUTE MARIN KITAGAWA THANK YOU POP-UP MODAL     -->
    <!-- ============================================== -->
    <div id="anime-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all duration-300">
