                class="w-full py-3.5 bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-extrabold rounded-2xl transition shadow-lg shadow-pink-500/30 flex items-center justify-center gap-2 text-sm active:scale-[0.99]">
