    <script>
        const baseUrl = '<%= baseUrl %>';
        let currentPayment = null;
        let countdownTimer = null;
        let pollTimer = null;
        let isPaid = false;
        let allRecentTransactions = <%- JSON.stringify(recentPayments || []) %>;
        let currentArchiveStatus = 'ALL';

        // Dark Mode Logic
        function initTheme() {
            const savedTheme = localStorage.getItem('yuripay_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-sun';
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-moon';
            }
        }

        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('yuripay_theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        }

        initTheme();

        // Audio files
        const arigatoLocal = new Audio('/sounds/cute-arigato.mp3');
        const arigatoOnline = new Audio('https://www.myinstants.com/media/sounds/cute-arigato.mp3');

        // Play Cute Arigato Sound Only
        function playCuteSound() {
            arigatoLocal.currentTime = 0;
            arigatoLocal.play().catch(() => {
                arigatoOnline.currentTime = 0;
                arigatoOnline.play().catch(e => console.warn('Audio play error:', e));
            });
        }

        function launchConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 90,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        function testSoundboxVoice() {
            showAnimePopup(15000);
            playCuteSound();
            launchConfetti();
        }

        function showAnimePopup(nominal) {
            document.getElementById('modal-amount').innerText = formatRupiah(nominal);
            document.getElementById('anime-modal').classList.remove('hidden');
        }

        function closeAnimeModal() {
            document.getElementById('anime-modal').classList.add('hidden');
        }

        function setNominal(amount) {
            document.getElementById('input-nominal').value = amount;
        }

        function formatRupiah(num) {
            return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
        }

        // Generate Dynamic Payment & QRIS (Idempotent)
        async function handleGenerateQR(openDirectly = false) {
            const nominalInput = document.getElementById('input-nominal');
            const nominal = parseInt(nominalInput.value, 10);
            const orderId = document.getElementById('input-order-id').value.trim();
            const memo = document.getElementById('input-memo').value.trim();
            const redirectUrl = document.getElementById('input-redirect').value.trim();
            const webhookUrl = document.getElementById('input-webhook').value.trim();

            if (isNaN(nominal) || nominal < 50) {
                alert('Silakan masukkan nominal pembayaran yang valid (Minimal Rp 50)');
                nominalInput.focus();
                return;
            }

            const btn = document.getElementById('btn-generate');
            const icon = document.getElementById('gen-icon');
            icon.className = 'fa-solid fa-spinner animate-spin';
            btn.disabled = true;

            try {
                const res = await fetch('/api/create-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        nominal,
                        order_id: orderId || null,
                        custom_name: memo,
                        redirect_url: redirectUrl,
                        webhook_url: webhookUrl
                    })
                });
                const result = await res.json();

                if (result.success && result.data) {
                    // Save active payment to sessionStorage to prevent loss or duplicate on page refresh
                    sessionStorage.setItem('yuripay_active_payment', JSON.stringify(result.data));

                    if (openDirectly) {
                        window.open(result.data.payment_url, '_blank');
                    }
                    showQRIS(result.data);
                    refreshDashboardData();
                } else {
                    alert('Gagal membuat tagihan: ' + (result.message || 'Error server'));
                }
            } catch (err) {
                alert('Terjadi kesalahan koneksi: ' + err.message);
            } finally {
                icon.className = 'fa-solid fa-bolt';
                btn.disabled = false;
            }
        }

        function showQRIS(payment) {
            currentPayment = payment;
            isPaid = false;

            document.getElementById('stage-input').classList.add('hidden');
            document.getElementById('stage-success').classList.add('hidden');
            document.getElementById('stage-qris').classList.remove('hidden');

            document.getElementById('display-title').innerText = payment.custom_name;
            document.getElementById('display-invoice').innerText = payment.payment_id;
            document.getElementById('display-amount').innerText = formatRupiah(payment.amount);
            document.getElementById('display-qr-img').src = payment.qr_image;

            document.getElementById('display-payment-url').value = payment.payment_url;
            document.getElementById('btn-open-payment-url').href = payment.payment_url;

            startCountdown(new Date(payment.expires_at).getTime());
            startPolling();
        }

        function copyPaymentUrl() {
            const url = document.getElementById('display-payment-url').value;
            navigator.clipboard.writeText(url).then(() => {
                const btn = document.getElementById('btn-copy-url-text');
                btn.innerText = 'Tersalin!';
                setTimeout(() => { btn.innerText = 'Salin'; }, 2000);
            });
        }

        function startCountdown(expiresTime) {
            if (countdownTimer) clearInterval(countdownTimer);

            countdownTimer = setInterval(() => {
                if (isPaid) {
                    clearInterval(countdownTimer);
                    return;
                }
                const now = Date.now();
                const diff = Math.max(0, expiresTime - now);
                const minutes = Math.floor(diff / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);

                document.getElementById('display-countdown').innerText = 
                    `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

                if (diff <= 0) {
                    clearInterval(countdownTimer);
                    document.getElementById('display-countdown').innerText = 'EXPIRED';
                    document.getElementById('status-text').innerText = 'Tagihan QRIS telah kedaluwarsa.';
                    sessionStorage.removeItem('yuripay_active_payment');
                }
            }, 1000);
        }

        function startPolling() {
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(async () => {
                if (isPaid || !currentPayment) {
                    clearInterval(pollTimer);
                    return;
                }
                await checkPaymentStatus(false);
            }, 3000);
        }

        async function checkPaymentStatus(isManual = false) {
            if (!currentPayment || isPaid) return;

            const statusText = document.getElementById('status-text');
            if (isManual) {
                const btn = document.getElementById('btn-manual-check');
                const icon = document.getElementById('check-icon');
                icon.classList.add('animate-spin');
                btn.disabled = true;
            }

            try {
                const res = await fetch(`/api/check-payment/${currentPayment.payment_id}`);
                const data = await res.json();

                if (data.success && data.paid) {
                    handlePaymentPaid(data.transaction);
                } else if (isManual) {
                    statusText.innerText = data.message || 'Pembayaran belum terdeteksi.';
                }
            } catch (e) {
                console.warn('Polling check error:', e);
            } finally {
                if (isManual) {
                    const btn = document.getElementById('btn-manual-check');
                    const icon = document.getElementById('check-icon');
                    icon.classList.remove('animate-spin');
                    btn.disabled = false;
                }
            }
        }

        function checkPaymentStatusNow() {
            checkPaymentStatus(true);
        }

        function handlePaymentPaid(tx) {
            isPaid = true;
            if (pollTimer) clearInterval(pollTimer);
            if (countdownTimer) clearInterval(countdownTimer);
            sessionStorage.removeItem('yuripay_active_payment');

            // 1. Play cute arigato sound only (no Google TTS)
            playCuteSound();

            // 2. Confetti celebration
            launchConfetti();

            // 3. Cute Marin Kitagawa Thank You Pop-up
            showAnimePopup(currentPayment.amount);

            // 4. Transition Background UI to Success Screen
            document.getElementById('stage-qris').classList.add('hidden');
            document.getElementById('stage-success').classList.remove('hidden');

            document.getElementById('success-nominal').innerText = formatRupiah(currentPayment.amount);

            const detailsBox = document.getElementById('success-details');
            detailsBox.innerHTML = `
                <div><span class="text-slate-400">ID Tagihan:</span> ${currentPayment.payment_id}</div>
                <div><span class="text-slate-400">ID Transaksi GoPay:</span> ${tx?.transaction_id || '-'}</div>
                <div><span class="text-slate-400">Penyedia:</span> ${tx?.payer_issuer || 'GoPay / QRIS'}</div>
                <div><span class="text-slate-400">Waktu:</span> ${tx?.transaction_time || new Date().toLocaleTimeString()}</div>
            `;

            refreshDashboardData();
            fetchRecentMutations();
            fetchWebhookLogs();
        }

        function cancelTransaction() {
            if (confirm('Batalkan tagihan ini dan kembali ke menu kasir?')) {
                resetToInput();
            }
        }

        function resetToInput() {
            isPaid = false;
            currentPayment = null;
            if (pollTimer) clearInterval(pollTimer);
            if (countdownTimer) clearInterval(countdownTimer);
            sessionStorage.removeItem('yuripay_active_payment');

            closeAnimeModal();

            document.getElementById('stage-qris').classList.add('hidden');
            document.getElementById('stage-success').classList.add('hidden');
            document.getElementById('stage-input').classList.remove('hidden');

            document.getElementById('input-nominal').value = '';
            document.getElementById('input-order-id').value = '';
            document.getElementById('input-memo').value = '';
            document.getElementById('input-nominal').focus();
        }

        // Fetch recent mutations
        async function fetchRecentMutations() {
            const listEl = document.getElementById('mutations-list');
            try {
                const res = await fetch('/api/recent-mutations');
                const data = await res.json();

                if (data.success && data.mutations && data.mutations.length > 0) {
                    listEl.innerHTML = data.mutations.map(tx => `
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder">
                            <div>
                                <p class="font-bold text-slate-800 dark:text-slate-200">${formatRupiah(tx.amount)}</p>
                                <p class="text-[10px] text-slate-400 font-mono">${tx.issuer} • ${tx.id.substring(0, 16)}...</p>
                            </div>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-googleGreen dark:text-emerald-400">
                                ${tx.status}
                            </span>
                        </div>
                    `).join('');
                } else {
                    listEl.innerHTML = '<p class="text-slate-400 text-center py-4 text-xs">Belum ada mutasi GoPay baru hari ini.</p>';
                }
            } catch (e) {
                listEl.innerHTML = '<p class="text-rose-400 text-center py-4 text-xs">Gagal memuat mutasi GoPay.</p>';
            }
        }

        // Fetch recent webhook delivery logs
        async function fetchWebhookLogs() {
            const listEl = document.getElementById('webhook-logs-list');
            try {
                const res = await fetch('/api/webhook-logs');
                const data = await res.json();

                if (data.success && data.logs && data.logs.length > 0) {
                    listEl.innerHTML = data.logs.map(log => `
                        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder flex items-center justify-between">
                            <div class="truncate max-w-[210px]">
                                <p class="font-mono font-bold text-slate-800 dark:text-slate-200">${log.order_id}</p>
                                <p class="text-[10px] text-slate-400 truncate">${log.webhook_url}</p>
                            </div>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${log.status === 'SUCCESS' ? 'bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400' : 'bg-rose-100 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400'}">
                                HTTP ${log.status_code || 500}
                            </span>
                        </div>
                    `).join('');
                } else {
                    listEl.innerHTML = '<p class="text-slate-400 text-center py-3 text-xs">Belum ada webhook yang dikirim.</p>';
                }
            } catch (e) {
                listEl.innerHTML = '<p class="text-rose-400 text-center py-3 text-xs">Gagal memuat log webhook.</p>';
            }
        }

        // Render archiving table with filtering & detail buttons
        function renderArchiveTable(items) {
            const tbody = document.getElementById('transactions-table-body');
            const emptyState = document.getElementById('archive-empty-state');
            if (!tbody) return;

            if (!items || items.length === 0) {
                tbody.innerHTML = '';
                if (emptyState) emptyState.classList.remove('hidden');
                return;
            }

            if (emptyState) emptyState.classList.add('hidden');

            tbody.innerHTML = items.map(item => {
                const isPaid = item.status === 'PAID';
                const isPending = item.status === 'PENDING';
                const statusBadgeClass = isPaid 
                    ? 'bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-300/40' 
                    : (isPending 
                        ? 'bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 border border-amber-300/40' 
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200 dark:border-slate-700');

                const timeStr = item.paid_at 
                    ? new Date(item.paid_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })
                    : (item.created_at ? new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '-');

                return `
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
                        <td class="py-2.5 font-mono font-bold text-googleBlue dark:text-sky-400">
                            <span class="hover:underline cursor-pointer" onclick="openArchiveDetail('${item.id}')">${item.id}</span>
                            ${item.order_id && item.order_id !== item.id ? `<span class="block text-[10px] text-slate-400 font-mono font-normal truncate max-w-[110px]">${item.order_id}</span>` : ''}
                        </td>
                        <td class="py-2.5 text-slate-700 dark:text-slate-300 max-w-[140px] truncate" title="${item.custom_name}">
                            ${item.custom_name}
                        </td>
                        <td class="py-2.5 font-mono font-bold text-slate-900 dark:text-slate-100">
                            ${formatRupiah(item.total_amount)}
                        </td>
                        <td class="py-2.5">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${statusBadgeClass} inline-flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full ${isPaid ? 'bg-emerald-500' : (isPending ? 'bg-amber-500' : 'bg-slate-400')}"></span>
                                <span>${item.status}</span>
                            </span>
                        </td>
                        <td class="py-2.5 text-slate-400 font-mono text-[11px]">
                            ${timeStr}
                        </td>
                        <td class="py-2.5 text-right space-x-1.5">
                            <button type="button" onclick="openArchiveDetail('${item.id}')" 
                                class="px-2 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-[11px] font-bold transition" title="Lihat Detail Pengarsipan">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <a href="${baseUrl}/pay/${item.id}" target="_blank" 
                               class="px-2 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/60 dark:hover:bg-blue-900 text-googleBlue dark:text-sky-400 text-[11px] font-bold inline-flex items-center gap-1 transition" title="Buka Halaman Checkout Port 3001">
                                <span>Pay</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                            </a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Filter archive status tab
        function filterArchiveStatus(status) {
            currentArchiveStatus = status;
            const tabs = ['ALL', 'PAID', 'PENDING', 'EXPIRED'];
            tabs.forEach(t => {
                const btn = document.getElementById('tab-status-' + t.toLowerCase());
                if (!btn) return;
                if (t === status) {
                    btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-googleBlue text-white shadow-sm transition flex items-center gap-1.5';
                } else {
                    btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition flex items-center gap-1.5';
                }
            });
            applyArchiveFilter();
        }

        // Apply search keyword + status filter
        function applyArchiveFilter() {
            const query = (document.getElementById('archive-search')?.value || '').toLowerCase().trim();

            let paidCount = 0;
            let pendingCount = 0;
            let expiredCount = 0;

            allRecentTransactions.forEach(item => {
                if (item.status === 'PAID') paidCount++;
                else if (item.status === 'PENDING') pendingCount++;
                else if (item.status === 'EXPIRED') expiredCount++;
            });

            const badgeAll = document.getElementById('badge-count-all');
            const badgePaid = document.getElementById('badge-count-paid');
            const badgePending = document.getElementById('badge-count-pending');
            const badgeExpired = document.getElementById('badge-count-expired');

            if (badgeAll) badgeAll.innerText = allRecentTransactions.length;
            if (badgePaid) badgePaid.innerText = paidCount;
            if (badgePending) badgePending.innerText = pendingCount;
            if (badgeExpired) badgeExpired.innerText = expiredCount;

            const filtered = allRecentTransactions.filter(item => {
                const matchStatus = currentArchiveStatus === 'ALL' || item.status === currentArchiveStatus;
                if (!matchStatus) return false;

                if (!query) return true;
                const idMatch = (item.id || '').toLowerCase().includes(query);
                const orderMatch = (item.order_id || '').toLowerCase().includes(query);
                const memoMatch = (item.custom_name || '').toLowerCase().includes(query);
                const amountMatch = String(item.total_amount || '').includes(query);
                return idMatch || orderMatch || memoMatch || amountMatch;
            });

            renderArchiveTable(filtered);
        }

        // Open archive detail modal
        function openArchiveDetail(id) {
            const item = allRecentTransactions.find(t => t.id === id);
            if (!item) return;

            document.getElementById('detail-modal-invoice-id').innerText = item.id;
            document.getElementById('detail-modal-order-id').innerText = item.order_id || item.id;
            document.getElementById('detail-modal-memo').innerText = item.custom_name || '-';
            document.getElementById('detail-modal-amount').innerText = formatRupiah(item.total_amount);
            document.getElementById('detail-modal-base').innerText = formatRupiah(item.base_amount || item.total_amount);
            document.getElementById('detail-modal-code').innerText = '+' + (item.unique_code || 0);

            const isPaid = item.status === 'PAID';
            const isPending = item.status === 'PENDING';
            const badgeEl = document.getElementById('detail-modal-status-badge');
            badgeEl.className = `px-2 py-0.5 rounded-full text-[10px] font-bold ${isPaid ? 'bg-emerald-100 text-emerald-700' : (isPending ? 'bg-amber-100 text-amber-700' : 'bg-slate-200 text-slate-700')}`;
            badgeEl.innerText = item.status;

            document.getElementById('detail-modal-created').innerText = item.created_at ? new Date(item.created_at).toLocaleString('id-ID') : '-';
            document.getElementById('detail-modal-expires').innerText = item.expires_at ? new Date(item.expires_at).toLocaleString('id-ID') : '-';
            document.getElementById('detail-modal-paid').innerText = item.paid_at ? new Date(item.paid_at).toLocaleString('id-ID') : (isPaid ? 'Terverifikasi' : 'Belum Bayar');

            const whStatusEl = document.getElementById('detail-modal-webhook-status');
            whStatusEl.className = item.webhook_sent ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700' : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500';
            whStatusEl.innerText = item.webhook_sent ? 'TERKIRIM (OK)' : (item.webhook_url ? 'BELUM TERKIRIM' : 'TIDAK ADA WEBHOOK');
            document.getElementById('detail-modal-webhook-url').innerText = item.webhook_url || 'Tidak dikonfigurasi saat pembuatan';

            const qrisBox = document.getElementById('detail-modal-qris-box');
            const qrisVal = document.getElementById('detail-modal-qris-val');
            if (item.qris_code) {
                qrisBox.classList.remove('hidden');
                qrisVal.innerText = item.qris_code;
            } else {
                qrisBox.classList.add('hidden');
            }

            document.getElementById('detail-modal-open-btn').href = `${baseUrl}/pay/${item.id}`;
            document.getElementById('archive-detail-modal').classList.remove('hidden');
        }

        function closeArchiveDetail() {
            document.getElementById('archive-detail-modal').classList.add('hidden');
        }

        function copyDetailText(elementId) {
            const text = document.getElementById(elementId)?.innerText;
            if (text && text !== '-') {
                navigator.clipboard.writeText(text).then(() => {
                    alert('Teks berhasil disalin!');
                });
            }
        }

        // Refresh transactions table and stats
        async function refreshDashboardData() {
            const icon = document.getElementById('refresh-icon');
            if (icon) icon.classList.add('animate-spin');

            try {
                const res = await fetch('/api/dashboard-data');
                const data = await res.json();
                if (data.success) {
                    if (data.stats) {
                        const s = data.stats;
                        const volEl = document.getElementById('stat-volume');
                        const allVolEl = document.getElementById('stat-all-volume');
                        const succEl = document.getElementById('stat-success');
                        const rateEl = document.getElementById('stat-success-rate');
                        const pendEl = document.getElementById('stat-pending');
                        const allPendEl = document.getElementById('stat-all-pending');
                        const expEl = document.getElementById('stat-expired');
                        const allExpEl = document.getElementById('stat-all-expired');

                        if (volEl) volEl.innerText = formatRupiah(s.todayVolume);
                        if (allVolEl) allVolEl.innerText = formatRupiah(s.allVolume);
                        if (succEl) succEl.innerHTML = `${s.todaySuccess} <span class="text-xs text-slate-400 font-normal">/ ${s.todayTotal} Hari Ini</span>`;
                        if (rateEl) rateEl.innerText = (s.successRate || 100) + '%';
                        if (pendEl) pendEl.innerText = s.todayPending;
                        if (allPendEl) allPendEl.innerText = s.allPending;
                        if (expEl) expEl.innerText = s.todayExpired || 0;
                        if (allExpEl) allExpEl.innerText = s.allExpired || 0;

                        // Traffic bar widths
                        const total = s.allTotal || 1;
                        const pSucc = Math.max(0, (s.allSuccess / total) * 100);
                        const pPend = Math.max(0, (s.allPending / total) * 100);
                        const pExp = Math.max(0, (s.allExpired / total) * 100);

                        const barS = document.getElementById('bar-success');
                        const barP = document.getElementById('bar-pending');
                        const barE = document.getElementById('bar-expired');
                        if (barS) barS.style.width = pSucc + '%';
                        if (barP) barP.style.width = pPend + '%';
                        if (barE) barE.style.width = pExp + '%';

                        const legS = document.getElementById('legend-success');
                        const legP = document.getElementById('legend-pending');
                        const legE = document.getElementById('legend-expired');
                        const totLbl = document.getElementById('traffic-total-label');
                        if (legS) legS.innerText = s.allSuccess;
                        if (legP) legP.innerText = s.allPending;
                        if (legE) legE.innerText = s.allExpired;
                        if (totLbl) totLbl.innerText = `Total ${s.allTotal} Transaksi Masuk`;
                    }

                    if (data.recent) {
                        allRecentTransactions = data.recent;
                        applyArchiveFilter();
                    }
                }
            } catch (e) {
                console.warn('Dashboard data refresh error:', e);
            } finally {
                if (icon) icon.classList.remove('animate-spin');
            }
        }

        // API Modal helpers
        function openApiModal() {
            document.getElementById('api-modal').classList.remove('hidden');
        }

        function closeApiModal() {
            document.getElementById('api-modal').classList.add('hidden');
        }

        function setApiTab(tab) {
            ['curl', 'node', 'php', 'python'].forEach(t => {
                document.getElementById('code-' + t).classList.add('hidden');
                const tabBtn = document.getElementById('tab-' + t);
                tabBtn.className = 'font-bold px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[11px]';
            });
            document.getElementById('code-' + tab).classList.remove('hidden');
            const activeTab = document.getElementById('tab-' + tab);
            activeTab.className = 'font-bold px-3 py-1 rounded-lg bg-googleBlue text-white text-[11px]';
        }

        // On Load: Restore active payment if user refreshed the page!
        window.addEventListener('DOMContentLoaded', async () => {
            applyArchiveFilter();
            fetchRecentMutations();
            fetchWebhookLogs();

            // AUTO-RESTORE ON REFRESH (ANTI-DUPLICATE PAYMENT)
            const saved = sessionStorage.getItem('yuripay_active_payment');
            if (saved) {
                try {
                    const p = JSON.parse(saved);
                    if (p && p.payment_id) {
                        const res = await fetch(`/api/check-payment/${p.payment_id}`);
                        const data = await res.json();
                        if (data.status === 'PENDING') {
                            console.log('Restoring active pending QRIS on refresh:', p.payment_id);
                            showQRIS(p);
                        } else if (data.status === 'PAID') {
                            currentPayment = p;
                            handlePaymentPaid(data.transaction);
                        } else {
                            sessionStorage.removeItem('yuripay_active_payment');
                        }
                    }
                } catch (e) {
                    sessionStorage.removeItem('yuripay_active_payment');
                }
            }
        });
    </script>
</body>
