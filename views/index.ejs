<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= appName %> Dashboard & Kasir - <%= storeName %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        googleBlue: '#1a73e8',
                        googleBlueHover: '#1557b0',
                        googleGreen: '#1e8e3e',
                        darkBg: '#0f172a',
                        darkCard: '#1e293b',
                        darkBorder: '#334155',
                        darkText: '#f8fafc',
                        darkSubtext: '#94a3b8'
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; }
        .font-mono { font-family: 'Roboto Mono', monospace; }
        @keyframes bounce-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .bounce-slow { animation: bounce-slow 2.5s infinite ease-in-out; }
        @keyframes scale-in {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .scale-in { animation: scale-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
</head>
<body class="bg-[#f0f4f9] dark:bg-darkBg text-slate-800 dark:text-darkText min-h-screen flex flex-col justify-between transition-colors duration-200">

    <!-- Top App Bar -->
    <header class="bg-white dark:bg-darkCard border-b border-slate-200 dark:border-darkBorder px-6 py-3.5 sticky top-0 z-30 shadow-sm transition-colors duration-200">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <!-- Brand -->
            <div class="flex items-center space-x-3">
                <% if (typeof storeLogoUrl !== 'undefined' && storeLogoUrl) { %>
                    <img src="<%= storeLogoUrl %>" alt="<%= storeName %>" class="w-10 h-10 rounded-2xl object-cover shadow-md border border-slate-200 dark:border-darkBorder">
                <% } else { %>
                    <div class="w-10 h-10 rounded-2xl bg-googleBlue text-white flex items-center justify-center text-lg shadow-md shadow-blue-500/20">
                        <i class="fa-solid fa-qrcode"></i>
                    </div>
                <% } %>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight flex items-center gap-2 text-slate-900 dark:text-white">
                        <span><%= appName %></span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-googleBlue dark:text-sky-400 border border-blue-200 dark:border-blue-900">
                            <%= storeName %>
                        </span>
                    </h1>
                    <p class="text-[11px] text-slate-500 dark:text-darkSubtext font-medium flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full <%= sessionValid ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500' %>"></span>
                        <span><%= sessionValid ? 'GoPay Gateway Online' : 'GoPay Siaga' %> • Kasir Port <%= dashboardPort %></span>
                    </p>
                </div>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
                <!-- Admin Email Badge -->
                <div class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder text-xs font-semibold text-slate-700 dark:text-slate-300">
                    <i class="fa-solid fa-user-shield text-googleBlue dark:text-sky-400"></i>
                    <span class="max-w-[150px] truncate"><%= adminEmail %></span>
                </div>

                <!-- API & Webhook Modal Button -->
                <button onclick="openApiModal()" 
                    class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-code text-googleBlue dark:text-sky-400"></i>
                    <span class="hidden sm:inline">API & Webhook</span>
                </button>

                <!-- Swagger UI Button -->
                <a href="/docs" target="_blank" 
                    class="px-3 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:hover:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 text-xs font-bold transition border border-emerald-200 dark:border-emerald-800/50 flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-book-open text-emerald-500"></i>
                    <span class="hidden sm:inline">Swagger UI</span>
                </a>

                <!-- Test Soundbox & Pop-up Demo -->
                <button onclick="testSoundboxVoice()" 
                    class="px-3 py-2 rounded-xl bg-pink-50 hover:bg-pink-100 dark:bg-pink-950/40 dark:hover:bg-pink-950/70 text-pink-700 dark:text-pink-300 text-xs font-bold transition border border-pink-200 dark:border-pink-800/50 flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-volume-high text-pink-500"></i>
                    <span class="hidden sm:inline">Uji Suara</span>
                </button>

                <!-- Dark / Light Mode Switch -->
                <button onclick="toggleDarkMode()" 
                    class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-amber-400 flex items-center justify-center transition border border-slate-200 dark:border-slate-700" 
                    title="Ganti Mode Tampilan">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>

                <!-- Logout Button -->
                <a href="/logout" 
                    class="w-9 h-9 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center transition border border-rose-200 dark:border-rose-900/50" 
                    title="Keluar / Logout Admin">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl w-full mx-auto p-4 sm:p-6 my-auto">

        <!-- Top Statistics & Traffic Overview -->
        <div class="mb-6 space-y-4">
            <!-- 4 Metric Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Omset -->
                <div class="bg-white dark:bg-darkCard rounded-2xl p-4 border border-slate-200 dark:border-darkBorder shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-bold text-slate-400 dark:text-darkSubtext uppercase tracking-wider">Omset Hari Ini</p>
                        <h3 id="stat-volume" class="text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400 mt-0.5">
                            <%= formatRupiah(stats.todayVolume) %>
                        </h3>
                        <p class="text-[10px] text-slate-400 mt-0.5">Total Semua: <span id="stat-all-volume" class="font-bold"><%= formatRupiah(stats.allVolume) %></span></p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>

                <!-- Transaksi Sukses -->
                <div class="bg-white dark:bg-darkCard rounded-2xl p-4 border border-slate-200 dark:border-darkBorder shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-bold text-slate-400 dark:text-darkSubtext uppercase tracking-wider">Transaksi Sukses (PAID)</p>
                        <h3 id="stat-success" class="text-2xl font-black font-mono text-googleBlue dark:text-sky-400 mt-0.5">
                            <%= stats.todaySuccess %> <span class="text-xs text-slate-400 font-normal">/ <%= stats.todayTotal %> Hari Ini</span>
                        </h3>
                        <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                            <i class="fa-solid fa-arrow-trend-up mr-0.5"></i>
                            <span id="stat-success-rate"><%= stats.successRate %>%</span> Tingkat Sukses
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-googleBlue dark:text-sky-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <!-- Menunggu Pembayaran (Pending) -->
                <div class="bg-white dark:bg-darkCard rounded-2xl p-4 border border-slate-200 dark:border-darkBorder shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-bold text-slate-400 dark:text-darkSubtext uppercase tracking-wider">Menunggu (PENDING)</p>
                        <h3 id="stat-pending" class="text-2xl font-black font-mono text-amber-600 dark:text-amber-400 mt-0.5">
                            <%= stats.todayPending %>
                        </h3>
                        <p class="text-[10px] text-slate-400 mt-0.5">Total Aktif: <span id="stat-all-pending" class="font-bold"><%= stats.allPending %></span> antrean</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>

                <!-- Kedaluwarsa (Expired) -->
                <div class="bg-white dark:bg-darkCard rounded-2xl p-4 border border-slate-200 dark:border-darkBorder shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-bold text-slate-400 dark:text-darkSubtext uppercase tracking-wider">Kedaluwarsa (EXPIRED)</p>
                        <h3 id="stat-expired" class="text-2xl font-black font-mono text-slate-600 dark:text-slate-400 mt-0.5">
                            <%= stats.todayExpired || 0 %>
                        </h3>
                        <p class="text-[10px] text-slate-400 mt-0.5">Total Arsip: <span id="stat-all-expired" class="font-bold"><%= stats.allExpired || 0 %></span> batal</p>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
            </div>

            <!-- Traffic Ratio & Flow Bar -->
            <div class="bg-white dark:bg-darkCard rounded-2xl p-4 border border-slate-200 dark:border-darkBorder shadow-sm">
                <div class="flex items-center justify-between text-xs mb-2">
                    <span class="font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
                        <i class="fa-solid fa-chart-simple text-googleBlue dark:text-sky-400"></i>
                        <span>Visualisasi Traffic Status Transaksi</span>
                    </span>
                    <span class="text-[11px] font-mono text-slate-400" id="traffic-total-label">
                        Total <%= stats.allTotal %> Transaksi Masuk
                    </span>
                </div>
                <!-- Multi-segment visual bar -->
                <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-3 overflow-hidden flex shadow-inner">
                    <div id="bar-success" class="bg-emerald-500 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allSuccess / stats.allTotal * 100) : 50 %>%;" title="Sukses"></div>
                    <div id="bar-pending" class="bg-amber-500 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allPending / stats.allTotal * 100) : 30 %>%;" title="Pending"></div>
                    <div id="bar-expired" class="bg-slate-400 dark:bg-slate-600 h-full transition-all duration-500" style="width: <%= stats.allTotal > 0 ? (stats.allExpired / stats.allTotal * 100) : 20 %>%;" title="Expired"></div>
                </div>
                <!-- Legend -->
                <div class="flex flex-wrap items-center justify-between text-[11px] text-slate-500 dark:text-darkSubtext mt-2.5 pt-1">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Sukses: <strong id="legend-success" class="text-slate-800 dark:text-slate-200"><%= stats.allSuccess %></strong></span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Pending: <strong id="legend-pending" class="text-slate-800 dark:text-slate-200"><%= stats.allPending %></strong></span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-slate-400 dark:bg-slate-600"></span> Expired: <strong id="legend-expired" class="text-slate-800 dark:text-slate-200"><%= stats.allExpired %></strong></span>
                    </div>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        Realtime Auto-Sync
                    </span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- LEFT COLUMN: KASIR & QRIS GENERATOR (7 Cols) -->
            <div class="lg:col-span-7 space-y-6">
                <div class="bg-white dark:bg-darkCard rounded-3xl p-6 sm:p-7 border border-slate-200 dark:border-darkBorder shadow-sm transition-colors duration-200">
                    
                    <!-- STAGE 1: FORM INPUT KASIR -->
                    <div id="stage-input">
                        <div class="mb-5 pb-3 border-b border-slate-100 dark:border-darkBorder">
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="fa-solid fa-cash-register text-googleBlue dark:text-sky-400"></i>
                                <span>Buat Tagihan QRIS Baru</span>
                            </h2>
                            <p class="text-xs text-slate-500 dark:text-darkSubtext mt-0.5">
                                Masukkan nominal untuk membuat kode pembayaran dan link redirect pelanggan.
                            </p>
                        </div>

                        <!-- Input Nominal -->
                        <div class="mb-5">
                            <label class="block text-xs font-bold text-slate-500 dark:text-darkSubtext uppercase tracking-wider mb-2">
                                Nominal Pembayaran (Rupiah)
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-xl font-black text-slate-400">
                                    Rp
                                </span>
                                <input type="number" id="input-nominal" min="50" placeholder="0" autofocus
                                    class="w-full pl-14 pr-4 py-3.5 bg-slate-50 dark:bg-slate-900 border-2 border-slate-200 dark:border-darkBorder rounded-2xl text-2xl font-black font-mono text-slate-900 dark:text-white focus:outline-none focus:border-googleBlue dark:focus:border-sky-500 transition">
                            </div>
                        </div>

                        <!-- Quick Nominal Chips -->
                        <div class="mb-5">
                            <p class="text-[11px] font-bold text-slate-400 dark:text-darkSubtext uppercase tracking-wider mb-2">Pilih Cepat:</p>
                            <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
                                <button type="button" onclick="setNominal(50)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">50</button>
                                <button type="button" onclick="setNominal(500)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">500</button>
                                <button type="button" onclick="setNominal(1000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">1.000</button>
                                <button type="button" onclick="setNominal(5000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">5.000</button>
                                <button type="button" onclick="setNominal(10000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">10.000</button>
                                <button type="button" onclick="setNominal(20000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">20.000</button>
                                <button type="button" onclick="setNominal(50000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">50.000</button>
                                <button type="button" onclick="setNominal(100000)" class="py-2 px-1 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-darkBorder text-xs font-bold text-slate-700 dark:text-slate-200 transition">100.000</button>
                            </div>
                        </div>

                        <!-- ID Pesanan / Order ID (Anti Duplicate on Refresh) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-darkSubtext uppercase tracking-wider mb-1.5 flex items-center justify-between">
                                    <span>ID Pesanan / Order ID</span>
                                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">Anti-Duplikat</span>
                                </label>
                                <input type="text" id="input-order-id" placeholder="Contoh: ORDER-1001"
                                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-xl text-xs font-medium text-slate-900 dark:text-white focus:outline-none focus:border-googleBlue dark:focus:border-sky-500 transition">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-darkSubtext uppercase tracking-wider mb-1.5">
                                    Catatan / Pelanggan (Opsional)
                                </label>
                                <input type="text" id="input-memo" placeholder="Contoh: Akun VIP / Pembeli #12"
                                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-xl text-xs font-medium text-slate-900 dark:text-white focus:outline-none focus:border-googleBlue dark:focus:border-sky-500 transition">
                            </div>
                        </div>

                        <!-- Redirect URL & Webhook URL -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-darkSubtext uppercase tracking-wider mb-1.5">
                                    Redirect URL (Opsional)
                                </label>
                                <input type="url" id="input-redirect" placeholder="https://toko-anda.com/selesai"
                                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-xl text-xs font-medium text-slate-900 dark:text-white focus:outline-none focus:border-googleBlue dark:focus:border-sky-500 transition">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 dark:text-darkSubtext uppercase tracking-wider mb-1.5 flex items-center justify-between">
                                    <span>Webhook URL (Midtrans)</span>
                                    <span class="text-[10px] text-googleBlue dark:text-sky-400 font-semibold">HTTP POST</span>
                                </label>
                                <input type="url" id="input-webhook" placeholder="https://toko-anda.com/api/webhook"
                                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-xl text-xs font-medium text-slate-900 dark:text-white focus:outline-none focus:border-googleBlue dark:focus:border-sky-500 transition">
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <button type="button" id="btn-generate" onclick="handleGenerateQR(false)"
                                class="py-3.5 bg-googleBlue hover:bg-googleBlueHover text-white font-bold rounded-2xl transition shadow-lg shadow-blue-500/25 flex items-center justify-center gap-2 text-sm">
                                <i class="fa-solid fa-bolt" id="gen-icon"></i>
                                <span>Cetak QR Kasir</span>
                            </button>
                            <button type="button" onclick="handleGenerateQR(true)"
                                class="py-3.5 bg-sky-600 hover:bg-sky-500 text-white font-bold rounded-2xl transition shadow-lg shadow-sky-600/25 flex items-center justify-center gap-2 text-sm">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span>Buat & Buka Pegs (Port 3001)</span>
                            </button>
                        </div>
                    </div>


                    <!-- STAGE 2: PREVIEW QRIS KASIR & LINK REDIRECT -->
                    <div id="stage-qris" class="hidden text-center">
                        <div class="flex items-center justify-between pb-3.5 border-b border-slate-100 dark:border-darkBorder mb-4">
                            <div class="text-left">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-darkSubtext">Tagihan Kasir</span>
                                <h3 id="display-title" class="text-sm font-bold text-slate-800 dark:text-slate-200 truncate max-w-[220px]">Pembayaran</h3>
                            </div>
                            <span id="display-invoice" class="font-mono text-xs font-bold px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-googleBlue dark:text-sky-400 border border-blue-200 dark:border-blue-900">
                                YURI-XXXX
                            </span>
                        </div>

                        <!-- Customer Payment Link Banner -->
                        <div class="p-3 bg-blue-50 dark:bg-slate-900 rounded-2xl border border-blue-200 dark:border-darkBorder text-left mb-4">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-darkSubtext mb-1">
                                Link Pembayaran Pelanggan (Port <%= paymentPort %>):
                            </p>
                            <div class="flex items-center gap-2">
                                <input type="text" id="display-payment-url" readonly 
                                    class="w-full bg-white dark:bg-darkCard px-3 py-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-xs font-mono text-googleBlue dark:text-sky-400 select-all">
                                <button type="button" onclick="copyPaymentUrl()" 
                                    class="px-3 py-1.5 bg-googleBlue hover:bg-googleBlueHover text-white text-xs font-bold rounded-xl transition flex items-center gap-1 shrink-0">
                                    <i class="fa-regular fa-copy"></i>
                                    <span id="btn-copy-url-text">Salin</span>
                                </button>
                                <a id="btn-open-payment-url" href="#" target="_blank"
