// 1. Buat pembayaran (Aman dari refresh karena ada order_id)
async function checkout() {
  const res = await axios.post('http://localhost:3000/api/create-payment', {
    nominal: 15000,
    order_id: 'ORDER-8892',
    webhook_url: 'https://tokosaya.com/api/webhook'
  });
  console.log('Redirect pembeli ke:', res.data.data.payment_url);
}

// 2. Handler Webhook di Express.js (100% format Midtrans)
app.post('/api/webhook', (req, res) => {
  const { order_id, transaction_status, gross_amount, signature_key } = req.body;
  
  if (transaction_status === 'settlement') {
    console.log(`Pembayaran pesanan ${order_id} LUNAS!`);
    // Berikan produk / update DB toko Anda
  }
  res.status(200).send('OK');
});</pre>

