<div class="space-y-8">

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h3 class="text-xl font-bold text-white">Riwayat Transaksi & Top Up</h3>
            <p class="text-xs text-slate-400 mt-1">Pantau seluruh pembayaran QRIS, saldo, serta persetujuan manual</p>
        </div>
    </div>

    <!-- Section: Product Orders -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-6 border-b border-slate-800 flex items-center justify-between">
            <h4 class="font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-cart-shopping text-indigo-400"></i>
                <span>Transaksi Pesanan Produk</span>
            </h4>
            <span class="text-xs text-slate-400">Total: <%= orders.length %> pesanan</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-400 bg-slate-950/60 border-b border-slate-800">
                        <th class="p-4">Invoice</th>
                        <th class="p-4">Pembeli (Discord)</th>
                        <th class="p-4">Produk</th>
                        <th class="p-4">Total</th>
                        <th class="p-4">Metode</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Kode Terkirim</th>
                        <th class="p-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% if (orders.length === 0) { %>
                        <tr>
                            <td colspan="8" class="p-8 text-center text-slate-500">Belum ada transaksi pesanan produk.</td>
                        </tr>
                    <% } %>
                    <% orders.forEach(o => { %>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="p-4 font-mono text-xs font-bold text-slate-300"><%= o.invoice %></td>
                            <td class="p-4 font-mono text-xs text-indigo-400"><%= o.discord_id %></td>
                            <td class="p-4 font-semibold text-white"><%= o.product_name %> (x<%= o.quantity %>)</td>
                            <td class="p-4 font-bold text-emerald-400"><%= formatRupiah(o.total_price) %></td>
                            <td class="p-4">
                                <span class="px-2.5 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-300">
                                    <%= o.payment_method %>
                                </span>
                            </td>
                            <td class="p-4">
                                <% if (o.status === 'PAID') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">LUNAS</span>
                                <% } else if (o.status === 'PENDING') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">PENDING</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-800 text-slate-400"><%= o.status %></span>
                                <% } %>
                            </td>
                            <td class="p-4">
                                <% if (o.items_delivered) { %>
                                    <span class="text-xs text-indigo-300 bg-slate-950 px-2 py-1 rounded font-mono truncate max-w-xs block" title="<%= o.items_delivered %>">
                                        <%= o.items_delivered %>
                                    </span>
                                <% } else { %>
                                    <span class="text-xs text-slate-600">-</span>
                                <% } %>
                            </td>
                            <td class="p-4 text-right">
                                <% if (o.status === 'PENDING') { %>
                                    <form action="/orders/manual-approve/<%= o.invoice %>" method="POST" onsubmit="return confirm('Setujui pesanan ini secara manual dan kirimkan produk ke DM pembeli?')" class="inline">
                                        <button type="submit" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg transition shadow-md shadow-emerald-600/30">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section: Top Up Requests -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-6 border-b border-slate-800 flex items-center justify-between">
            <h4 class="font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-wallet text-emerald-400"></i>
                <span>Transaksi Top Up Saldo</span>
            </h4>
            <span class="text-xs text-slate-400">Total: <%= topups.length %> topup</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-400 bg-slate-950/60 border-b border-slate-800">
                        <th class="p-4">Invoice</th>
                        <th class="p-4">Discord ID</th>
                        <th class="p-4">Nominal Masuk</th>
                        <th class="p-4">Total Transfer</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Waktu Dibuat</th>
                        <th class="p-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% if (topups.length === 0) { %>
                        <tr>
                            <td colspan="7" class="p-8 text-center text-slate-500">Belum ada mutasi top up saldo.</td>
                        </tr>
                    <% } %>
                    <% topups.forEach(t => { %>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="p-4 font-mono text-xs font-bold text-slate-300"><%= t.invoice %></td>
                            <td class="p-4 font-mono text-xs text-indigo-400"><%= t.discord_id %></td>
                            <td class="p-4 font-bold text-emerald-400"><%= formatRupiah(t.nominal) %></td>
                            <td class="p-4 text-slate-300"><%= formatRupiah(t.total_amount) %></td>
                            <td class="p-4">
                                <% if (t.status === 'PAID') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">LUNAS</span>
                                <% } else if (t.status === 'PENDING') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">PENDING</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-800 text-slate-400"><%= t.status %></span>
                                <% } %>
                            </td>
                            <td class="p-4 text-xs text-slate-400"><%= t.created_at %></td>
                            <td class="p-4 text-right">
                                <% if (t.status === 'PENDING') { %>
                                    <form action="/topups/manual-approve/<%= t.invoice %>" method="POST" onsubmit="return confirm('Setujui top up ini secara manual dan tambahkan saldo ke member?')" class="inline">
                                        <button type="submit" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg transition shadow-md shadow-emerald-600/30">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>
