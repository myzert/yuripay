<div class="space-y-8">

    <!-- Header Actions -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h3 class="text-xl font-bold text-white">Mutasi Transaksi Real-Time</h3>
            <p class="text-xs text-slate-400 mt-1">Riwayat pembayaran QRIS dan GoPay langsung dari server GoBiz Analytics</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/mutasi" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold rounded-xl transition border border-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-rotate text-cyan-400"></i>
                <span>Muat Ulang Mutasi</span>
            </a>
            <a href="/qris" class="px-4 py-2.5 bg-[#00AED6] hover:bg-[#0084A3] text-white text-sm font-semibold rounded-xl transition shadow-lg shadow-cyan-500/30 flex items-center gap-2">
                <i class="fa-solid fa-plus"></i>
                <span>Buat QRIS Baru</span>
            </a>
        </div>
    </div>

    <% if (error) { %>
        <div class="p-4 rounded-2xl bg-rose-950/80 border border-rose-800/50 text-rose-300 text-sm flex items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <!-- Mutations Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                Total Mutasi Ditemukan: <b class="text-white"><%= transactions.length %></b>
            </span>
            <span class="text-xs text-cyan-400 font-mono">
                Merchant: <%= session?.merchant_id || 'G538138242' %>
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-400 bg-slate-950/60 border-b border-slate-800">
                        <th class="p-4">Waktu Transaksi</th>
                        <th class="p-4">ID Transaksi / Order ID</th>
                        <th class="p-4">Customer</th>
                        <th class="p-4">Penyedia (Issuer)</th>
                        <th class="p-4">Nominal</th>
                        <th class="p-4 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-500">
                                Belum ada mutasi transaksi dalam 7 hari terakhir.
                            </td>
                        </tr>
                    <% } %>
                    <% transactions.forEach(tx => { 
                        const rawAmt = parseInt(tx.gross_amount || tx.real_gross_amount || tx.amount || 0, 10);
                        const displayAmt = rawAmt > 100000 ? Math.round(rawAmt / 100) : rawAmt;
                    %>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="p-4 text-xs text-slate-300 font-mono">
                                <%= tx.transaction_time || tx.settlement_time || '-' %>
                            </td>
                            <td class="p-4 font-mono text-xs text-slate-300">
                                <%= tx.id || tx.order_id %>
                            </td>
                            <td class="p-4 text-xs text-slate-200">
                                <% if (tx.customer_first_name) { %>
                                    <b><%= tx.customer_first_name %></b>
                                    <span class="block text-[10px] text-slate-500"><%= tx.customer_phone || tx.customer_email || '' %></span>
                                <% } else { %>
                                    <span class="text-slate-500">-</span>
                                <% } %>
                            </td>
                            <td class="p-4">
                                <span class="px-2.5 py-1 rounded text-xs font-semibold bg-slate-800 text-cyan-300 border border-slate-700/60">
                                    <%= tx.qris_provider_aspi_issuer || tx.payment_type || 'GOPAY' %>
                                </span>
                            </td>
                            <td class="p-4 font-bold text-emerald-400 text-base">
                                <%= formatRupiah(displayAmt) %>
                            </td>
                            <td class="p-4 text-right">
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                    <%= tx.transaction_status || 'SETTLEMENT' %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>
