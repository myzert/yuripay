<div class="space-y-8">

    <!-- Top Merchant Identity Card -->
    <div class="bg-gradient-to-r from-cyan-950/70 via-slate-900 to-emerald-950/70 border border-cyan-800/40 rounded-3xl p-6 shadow-2xl relative overflow-hidden">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#00AED6] to-[#00880C] flex items-center justify-center text-white text-2xl shadow-lg shadow-cyan-500/30">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-xl font-extrabold text-white">
                            <%= session?.outlet_name || 'ZERO SHOP, MEGALUH' %>
                        </h3>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                            TERVERIFIKASI
                        </span>
                    </div>
                    <p class="text-xs text-slate-300 mt-1 flex items-center gap-3">
                        <span><b class="text-slate-400">Merchant ID:</b> <code class="text-cyan-400 bg-slate-950/80 px-2 py-0.5 rounded font-mono font-bold"><%= session?.merchant_id || 'G538138242' %></code></span>
                        <span>•</span>
                        <span><b class="text-slate-400">Nomor HP:</b> <span class="text-white"><%= session?.phone_number || '+6285141145301' %></span></span>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="px-4 py-2.5 bg-slate-950/80 border border-slate-800 rounded-2xl flex items-center gap-2.5">
                    <span class="w-3 h-3 rounded-full <%= isGatewayLive ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400' %>"></span>
                    <div class="text-left">
                        <p class="text-[10px] uppercase font-bold text-slate-500">GoPay Gateway Status</p>
                        <p class="text-xs font-bold text-slate-200"><%= isGatewayLive ? 'ONLINE & SIAP TRANSAKSI' : 'STANDBY / PERIKSA SESI' %></p>
                    </div>
                </div>
                <a href="/qris" class="px-5 py-3 bg-[#00AED6] hover:bg-[#0084A3] text-white rounded-2xl text-xs font-bold transition shadow-lg shadow-cyan-500/30 flex items-center gap-2">
                    <i class="fa-solid fa-qrcode"></i>
                    <span>Cetak QRIS</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Analytics Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Today's Revenue -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Omset Hari Ini (GoPay)</p>
                    <h4 class="text-2xl font-extrabold text-white mt-2"><%= formatRupiah(todayGoPayIncome) %></h4>
                    <p class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
                        <i class="fa-solid fa-bolt"></i>
                        <span><%= todayMutations.length %> transaksi masuk hari ini</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
            </div>
        </div>

        <!-- Total Store Orders -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Transaksi Toko</p>
                    <h4 class="text-2xl font-extrabold text-white mt-2"><%= stats.totalSalesCount %> Pesanan</h4>
                    <p class="text-xs text-cyan-400 mt-2">
                        <span>Total: <%= formatRupiah(stats.totalRevenue) %></span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </div>
        </div>

        <!-- Available Stock -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Stok Lisensi / Key</p>
                    <h4 class="text-2xl font-extrabold text-white mt-2"><%= stats.availableStocks %> Item</h4>
                    <p class="text-xs text-slate-400 mt-2">
                        <span><%= stats.soldStocks %> lisensi telah terjual</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-key"></i>
                </div>
            </div>
        </div>

        <!-- Active Products -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Katalog Produk</p>
                    <h4 class="text-2xl font-extrabold text-white mt-2"><%= stats.totalProducts %> Produk</h4>
                    <p class="text-xs text-purple-400 mt-2">
                        <span>Siap dipesan pembeli</span>
                    </p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Live GoPay Settlement Feed -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl flex flex-col">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h4 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-arrow-down-long text-emerald-400"></i>
                    <span>Mutasi Masuk GoPay Hari Ini</span>
                </h4>
                <p class="text-xs text-slate-400">Data mutasi real-time langsung dari server Gojek Partner Analytics</p>
            </div>
            <a href="/mutasi" class="text-xs text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1">
                <span>Lihat Semua Mutasi</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-500 border-b border-slate-800">
                        <th class="pb-3">Waktu</th>
                        <th class="pb-3">ID Transaksi / Order</th>
                        <th class="pb-3">Penyedia / Issuer</th>
                        <th class="pb-3">Nominal Masuk</th>
                        <th class="pb-3 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% if (todayMutations.length === 0) { %>
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-500 text-xs">
                                Belum ada mutasi transaksi GoPay untuk hari ini.
                            </td>
                        </tr>
                    <% } %>
                    <% todayMutations.forEach(tx => { 
                        const rawAmt = parseInt(tx.gross_amount || tx.real_gross_amount || tx.amount || 0, 10);
                        const displayAmt = rawAmt > 100000 ? Math.round(rawAmt / 100) : rawAmt;
                    %>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="py-3 text-xs text-slate-400 font-mono"><%= tx.transaction_time || tx.settlement_time || '-' %></td>
                            <td class="py-3 font-mono text-xs text-slate-300"><%= tx.id || tx.order_id %></td>
                            <td class="py-3">
                                <span class="px-2.5 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-200">
                                    <%= tx.qris_provider_aspi_issuer || tx.payment_type || 'GOPAY' %>
                                </span>
                            </td>
                            <td class="py-3 font-bold text-emerald-400"><%= formatRupiah(displayAmt) %></td>
                            <td class="py-3 text-right">
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                    <%= tx.transaction_status || 'SETTLEMENT' %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>
