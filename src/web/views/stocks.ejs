<div class="space-y-8">

    <!-- Header Actions & Filter -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h3 class="text-xl font-bold text-white">Manajemen Stok & Kode Key</h3>
            <p class="text-xs text-slate-400 mt-1">Impor lisensi produk secara massal dan pantau status key</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="document.getElementById('modal-bulk-import').classList.remove('hidden')"
                class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                <i class="fa-solid fa-file-import"></i>
                <span>Impor Kode Key (Bulk)</span>
            </button>
        </div>
    </div>

    <!-- Product Filter Dropdown -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 w-full md:w-auto">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 whitespace-nowrap">Filter Produk:</span>
            <form action="/stocks" method="GET" class="w-full md:w-auto">
                <select name="product_id" onchange="this.form.submit()" class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500">
                    <option value="">-- Semua Produk --</option>
                    <% products.forEach(p => { %>
                        <option value="<%= p.id %>" <%= selectedProduct === p.id ? 'selected' : '' %>>
                            <%= p.name %> (Stok: <%= p.stock_count %>)
                        </option>
                    <% }) %>
                </select>
            </form>
        </div>
        <div class="flex items-center gap-4 text-xs font-medium text-slate-400">
            <span>Total Item: <b class="text-white"><%= stocks.length %></b></span>
            <span>Tersedia: <b class="text-emerald-400"><%= stocks.filter(s => s.status === 'available').length %></b></span>
            <span>Terjual: <b class="text-indigo-400"><%= stocks.filter(s => s.status === 'sold').length %></b></span>
        </div>
    </div>

    <!-- Stocks Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="text-xs uppercase tracking-wider text-slate-400 bg-slate-950/60 border-b border-slate-800">
                        <th class="p-4">ID</th>
                        <th class="p-4">Produk</th>
                        <th class="p-4">Isi Lisensi / Kode / Akun</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Tanggal Masuk</th>
                        <th class="p-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60">
                    <% if (stocks.length === 0) { %>
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-500">Belum ada stok kode lisensi untuk kriteria ini.</td>
                        </tr>
                    <% } %>
                    <% stocks.forEach(s => { %>
                        <tr class="hover:bg-slate-800/30 transition">
                            <td class="p-4 text-slate-500 font-mono text-xs">#<%= s.id %></td>
                            <td class="p-4 font-semibold text-white"><%= s.product_name %></td>
                            <td class="p-4">
                                <div class="font-mono text-xs bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800/80 max-w-sm truncate text-indigo-300 select-all">
                                    <%= s.content %>
                                </div>
                            </td>
                            <td class="p-4">
                                <% if (s.status === 'available') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                        🟢 TERSEDIA
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                                        ✅ TERJUAL
                                    </span>
                                <% } %>
                            </td>
                            <td class="p-4 text-xs text-slate-400"><%= s.created_at %></td>
                            <td class="p-4 text-right">
                                <% if (s.status === 'available') { %>
                                    <form action="/stocks/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus key ini?')" class="inline">
                                        <button type="submit" class="p-2 text-slate-400 hover:text-rose-400 transition">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-xs text-slate-600">Order #<%= s.order_id || '-' %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal: Bulk Import Keys -->
    <div id="modal-bulk-import" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full p-6 shadow-2xl">
            <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
                <div>
                    <h4 class="text-lg font-bold text-white">Impor Kode Lisensi Masal</h4>
                    <p class="text-xs text-slate-400">Masukkan satu kode atau link per baris</p>
                </div>
                <button onclick="document.getElementById('modal-bulk-import').classList.add('hidden')" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form action="/stocks/bulk-import" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Pilih Produk Tujuan</label>
                    <select name="product_id" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-indigo-500">
                        <% products.forEach(p => { %>
                            <option value="<%= p.id %>" <%= selectedProduct === p.id ? 'selected' : '' %>>
                                <%= p.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Daftar Kode / Key (1 baris per item)</label>
                    <textarea name="keys" rows="8" required placeholder="STEAM-A9812-KJ891-PO124&#10;STEAM-B9182-PO192-LK712&#10;https://discord.com/billing/promotions/sample-link"
                        class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white font-mono text-xs focus:outline-none focus:border-indigo-500"></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
                    <button type="button" onclick="document.getElementById('modal-bulk-import').classList.add('hidden')"
                        class="px-4 py-2 text-slate-400 hover:text-white font-medium">Batal</button>
                    <button type="submit"
                        class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition shadow-md shadow-indigo-600/30 flex items-center gap-2">
                        <i class="fa-solid fa-upload"></i>
                        <span>Mulai Impor Stok</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
