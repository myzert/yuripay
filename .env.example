# YuriPay by myzert - Environment Configuration Template
# Salin file ini menjadi .env dan isi dengan konfigurasi merchant Anda

# Port Settings (Wajib Port Stateful terisolasi)
DASHBOARD_PORT=3000
PAYMENT_PORT=3001

# App & Store Identity
STORE_NAME=YuriDev
APP_NAME="YURIPAY by myzert"
# URL atau path logo toko kustom (Opsional, kosongkan jika ingin menggunakan logo default)
STORE_LOGO_URL=""
# Tema Layar Sukses Pembayaran: "anime" (Marin Kitagawa pop-up & cute audio) atau "default" (Corporate fintech chime)
DEFAULT_SUCCESS_THEME="anime"

# API Secret Key (Digunakan untuk kalkulasi Signature Key Webhook Midtrans)
API_KEY=yuripay_live_secret_key_change_me

# Admin Dashboard Authentication (Port 3000)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here
SESSION_SECRET=your_random_session_secret_change_me

# GoPay Merchant Gateway Configuration (Private - Never expose to public)
GOPAY_MERCHANT_ID=G123456789
QRIS_STATIC=00020101021126610014COM.GO-JEK.WWW...
MIN_NOMINAL=50
TRANSACTION_TIMEOUT_MINUTES=10

# Stealth Root Auto-Redirect for Port 3001 (Pencegah Scanner / Bot Probe)
# Pilihan aman: "https://www.google.com" atau "https://github.com/myzert/yuripay"
PAYMENT_ROOT_REDIRECT_URL="https://www.google.com"
